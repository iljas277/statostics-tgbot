BOT_TOKEN=123456:ABCDEF
CHANNEL_ID=-1001234567890
# Optional, but recommended for comments ingestion from discussion group
LINKED_CHAT_ID=-1009876543210
# Comma-separated Telegram user IDs with admin access
ADMIN_IDS=111111111,222222222
# Optional SOCKS5 proxy for Telegram Bot API requests
TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080
# How many latest channel posts to use in metrics summaries
MTPROTO_METRICS_POSTS_LIMIT=50
# Run local unit tests and Telegram connectivity checks before bot starts
RUN_STARTUP_TESTS=true
DB_PATH=data/bot.sqlite3
LOG_LEVEL=INFO
TZ=UTC

# Contacts list settings
# Build /contacts from last N posts
CONTACTS_POSTS_LIMIT=30
# Keep top N commenters in contacts list
CONTACTS_COMMENTERS_LIMIT=20
# Refresh contacts list daily at HH:MM in TZ
CONTACTS_REFRESH_HOUR=9
CONTACTS_REFRESH_MINUTE=0

# Web panel settings
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_RELOAD=false

# Default number of days for analytics charts
CHART_DEFAULT_DAYS=14
